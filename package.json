{
  "name": "cps-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run desktop",
    "desktop": "concurrently -k \"vite --host 0.0.0.0 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "tsx src/server/prod.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "mssql": "^12.7.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/mssql": "^12.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^35.7.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "wait-on": "^8.0.3"
  }
}
